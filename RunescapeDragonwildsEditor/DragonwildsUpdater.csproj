<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>DragonwildsUpdater</AssemblyName>
    <RootNamespace>DragonwildsUpdater</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Self-contained: ships as a single .exe, no .NET required on user machine -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <Version>0.10.3.0</Version>
    <AssemblyVersion>0.10.3.0</AssemblyVersion>
    <FileVersion>0.10.3.0</FileVersion>
    <Company>Elleandria</Company>
    <Product>Dragonwilds Updater</Product>
    <Description>Auto-updater for the RS Dragonwilds Save Editor</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- CUE4Parse: built from source submodule for latest UE version support.
         To update: git submodule update - -remote CUE4Parse  then rebuild. -->
    <ProjectReference Include="..\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
    <ProjectReference Include="..\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />

    <!-- SkiaSharp: converts DXT-compressed textures to PNG -->
    <PackageReference Include="SkiaSharp" Version="*" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="*" />
  </ItemGroup>

</Project>
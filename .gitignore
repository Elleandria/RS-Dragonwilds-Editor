# -------------------------------------------------------
# PyInstaller build output
# -------------------------------------------------------
build/
dist/
*.onefile-build/
__pycache__/
*.pyc
*.pyo
*.pyd

# -------------------------------------------------------
# .NET build output
# -------------------------------------------------------
RunescapeDragonwildsEditor/bin/
RunescapeDragonwildsEditor/obj/
RunescapeDragonwildsEditor/*.dll

# -------------------------------------------------------
# Compiled executables (ship via Nexusmods, not GitHub)
# -------------------------------------------------------
*.exe

# -------------------------------------------------------
# Game asset icons — generated by updater, not source code
# These are extracted from the game and can be regenerated
# by running DragonwildsUpdater.exe at any time.
# -------------------------------------------------------
assets/UI/*.png
assets/UI/old/

# -------------------------------------------------------
# Logs, temp, OS junk
# -------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
CONTEXT.md

# -------------------------------------------------------
# Python virtual environments
# -------------------------------------------------------
venv/
.venv/
env/
ENV/
.vscode/
.claude/

# -------------------------------------------------------
# IDE project files (machine-specific, not useful to repo consumers)
# -------------------------------------------------------
*.sln
*.suo
*.user
.vs/
*.htm

# -------------------------------------------------------
# Keep these always tracked (explicit includes)
# -------------------------------------------------------
# Source code
!save_editor.py
!data/IDscan.py
!data/CleanToItemJsons.py
!assets/UpdateIcons.py

# Batch files (manual pipeline, kept as fallback)
!UpdateAll.bat
!UpdateEXE.bat
!data/UpdateItems.bat

# C# updater source (rebuild anytime with dotnet publish)
!RunescapeDragonwildsEditor/DragonwildsUpdater.csproj
!RunescapeDragonwildsEditor/Program.cs
!RunescapeDragonwildsEditor/Extractor.cs

# Mappings file (version-specific, small, critical for updater)
!RunescapeDragonwildsEditor/*.usmap

# Item data (small JSON, useful as reference and for the editor)
!data/ItemID.json

# Version and spec
!version.txt
!save_editor.spec